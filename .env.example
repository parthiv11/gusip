# GUSIP environment — copy to .env
APP_NAME=GUSIP
APP_ENV=poc
# JSON logs (for a log aggregator) vs human-readable text; both include a
# request_id field/tag for cross-log correlation (see /metrics for Prometheus).
LOG_JSON=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
SESSION_COOKIE_SECURE=false
LOCAL_AUTH_ENABLED=true
AUTH_PROVIDER=local
# Production OIDC / Keycloak settings
OIDC_ISSUER=https://id.example.in/realms/gusip
OIDC_AUDIENCE=gusip
OIDC_JWKS_URL=https://id.example.in/realms/gusip/protocol/openid-connect/certs
OIDC_AUTHORIZATION_URL=https://id.example.in/realms/gusip/protocol/openid-connect/auth
OIDC_TOKEN_URL=https://id.example.in/realms/gusip/protocol/openid-connect/token
OIDC_CLIENT_ID=gusip
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://gusip.example.in/api/v1/auth/oidc/callback
DATABASE_URL=postgresql+asyncpg://gusip:gusip@postgres:5432/gusip
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=gusip
MINIO_SECRET_KEY=gusipsecret
MINIO_BUCKET=gusip-evidence
MINIO_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
SIMULATION_ENABLED=true
SIMULATION_CAMERAS=50
INFERENCE_MODE=simulate
INFERENCE_MODEL_PATH=/tmp/gusip/models/yolov8n.pt
INFERENCE_PLATE_MODEL_PATH=/tmp/gusip/models/license-plate-yolo11n.pt
WORKER_INFERENCE_MODE=yolo
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
USE_KAFKA=false
AUDIT_ENABLED=true
ENCRYPTION_KEY=poc-dev-key-change-me-32bytes!!
# JSON map of adapter ID to a unique 32+ character HMAC key.
ADAPTER_KEYS_JSON={"dept-demo":"replace-with-openssl-rand-hex-32"}
INGEST_MAX_CLOCK_SKEW_SECONDS=300
# Purges raw DetectionEvent/TrackPoint rows (and their snapshot files) past this
# age; never touches Alerts or anything an Alert still references. 0 disables it.
DETECTION_RETENTION_DAYS=90
RETENTION_SWEEP_INTERVAL_HOURS=24
SENTINEL_BASE_URL=https://cctv.corp8.cloud
SENTINEL_ENABLED=true
SENTINEL_ANPR_ENABLED=true
SENTINEL_ANPR_INTERVAL_S=10
# RTSP/WHEP on the public static IP (CDN cannot proxy those ports)
SENTINEL_RTSP_ENABLED=true
SENTINEL_RTSP_HOST=103.250.160.189
SENTINEL_EMAIL=
SENTINEL_PASSWORD=
SENTINEL_ALLOWED_HOSTS=live.sentinelgujarat.in,live.corp8.cloud,cctv.corp8.cloud,stream.corp8.cloud,103.250.160.189
SENTINEL_USER_AGENT=Mozilla/5.0 (compatible; GUSIP/1.0; Sentinel ingest)
SENTINEL_REFERER=https://cctv.corp8.cloud/
# Internal MediaMTX when public :8554 is not reachable (Cloudflare does not proxy RTSP).
SENTINEL_LOCAL_RTSP_URL=rtsp://mediamtx:8554
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp
FACE_ENABLED=true
FACE_MODEL=buffalo_l
FACE_MODEL_ROOT=/app/data/insightface
FACE_PACK_URL=https://github.com/deepinsight/insightface/releases/download/v0.7/buffalo_l.zip
FACE_MIN_DET_SCORE=0.4
